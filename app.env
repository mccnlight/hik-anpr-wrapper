# --- Upstream и камеры ---
UPSTREAM_URL=https://snowops-anpr-service.onrender.com/api/v1/anpr/events
PLATE_CAMERA_ID=shahovskoye

# --- Снеговой воркер и режим очередей ---
ENABLE_SNOW_WORKER=true
ENABLE_LINE_PAIRING=true
SNOW_VIDEO_SOURCE_URL=rtsp://admin:Armat456321@194.26.239.249:555/Streaming/Channels/101
SNOW_CAMERA_ID=camera-snow
SNOW_SHOW_WINDOW=true

# --- Линия пересечения (нормализованные 0..1). Направление: r2l (справа налево) ---
LINE_X1=0.230
LINE_Y1=0.300
LINE_X2=0.350
LINE_Y2=0.840
LINE_DIRECTION=backward

# --- Merge (сопоставление снег ↔ ANPR по времени) ---
MERGE_WINDOW_SECONDS=20
MERGE_TTL_SECONDS=50
MERGE_MAX_EVENT_AGE_SECONDS=30.0
MERGE_REQUIRE_SNOW_MATCH=true

# --- Проверка машины в базе (мерджер и опционально API) ---
MERGER_VEHICLE_CHECK_URL=https://snowops-anpr-service.onrender.com/internal/vehicles/check
MERGER_VEHICLE_CHECK_TOKEN=snowops-internal-secret
VEHICLE_CHECK_URL=https://snowops-anpr-service.onrender.com/internal/vehicles/check
VEHICLE_CHECK_TOKEN=snowops-internal-secret

# --- Gemini (только распознавание номера) ---
GEMINI_API_KEY=AIzaSyASnvHca1rosu2tNzky8A6OxSf5h3QWmYM
GEMINI_MODEL=gemini-2.5-flash

# --- Часовой пояс и время события ---
LOCAL_TZ_OFFSET_HOURS=5

# --- Снег: YOLO для детекции грузовиков на линии и для детекции снега на кузове ---
SNOW_YOLO_MODEL_PATH=yolov8n.pt
SNOW_CAPTURE_DELAY_SECONDS=0.5
SNOW_STATIONARY_TIMEOUT_SECONDS=10.0
SNOW_CENTER_ZONE_START_X=0.02
SNOW_CENTER_ZONE_START_Y=0.0
SNOW_CENTER_ZONE_END_X=0.40
SNOW_CENTER_ZONE_END_Y=1.0

# --- FFmpeg (разрешение и FPS для снегового потока) ---
SNOW_FFMPEG_OUT_W=1280
SNOW_FFMPEG_OUT_H=720
SNOW_FFMPEG_INPUT_FPS=6.0

# --- Обученная модель снега на кузове (truck+snow). Данные: hik-anpr-wrapper/dataset, обучение: python train_yolo.py ---
SNOW_YOLO_WEIGHTS=models/training_runs/snow_detection/weights/best.pt
# Пороги детекции (если snow_detected=False при видимом снеге — понизь; см. логи [SNOW_DETECT])
SNOW_IOU_THRESHOLD=0.1
SNOW_CONF_THRESHOLD=0.25
SNOW_TRUCK_CONF_THRESHOLD=0.2

# --- Очереди сопоставления (при ENABLE_LINE_PAIRING=true) ---
# PAIRING_SNOW_QUEUE_MAXLEN=30
# PAIRING_PLATE_QUEUE_MAXLEN=30
# PAIRING_TIME_WINDOW_SECONDS=0
